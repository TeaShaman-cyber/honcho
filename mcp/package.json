{
  "name": "honcho-mcp",
  "version": "3.3.0",
  "description": "Honcho MCP Server",
  "main": "src/index.ts",
  "packageManager": "bun@1.4.4",
  "engines": {
    "node": ">=18.0.0",
    "bun": ">=1.4.4"
  },
  "scripts": {
    "preinstall": "node -e \"const ua=process.env.npm_config_user_agent||'';if(ua.includes('npm')&&!ua.includes('bun')){console.error('❌ Please use bun instead of npm!\\n📦 Run: bun install\\n🌐 Install bun: https://bun.sh/');process.exit(1)}\"",
    "dev": "wrangler dev",
    "stdio": "bun src/stdio.ts",
    "http": "bun src/http.ts",
    "test": "bun test src",
    "lint": "biome lint src/",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun run test && bun run lint",
    "check:deploy": "bun install --frozen-lockfile && bun run check",
    "deploy": "bun run check:deploy && wrangler deploy",
    "deploy:staging": "bun run check:deploy && wrangler deploy --env staging"
  },
  "dependencies": {
    "@honcho-ai/sdk": "^2.8.0",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "@sentry/bun": "^11.1.0",
    "@sentry/cloudflare": "^11.1.0",
    "agents": "^0.4.0",
    "nanoid": "^5.1.7",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@cloudflare/workers-types": "^4.20241002.0",
    "typescript": "^5.3.3",
    "wrangler": "^4.24.3"
  }
}
